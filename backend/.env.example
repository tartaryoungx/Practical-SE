# Copy to backend/.env. FastAPI and Alembic both load this file.
# Use localhost, not the Compose service hostname.
# URL-encode the password if it contains reserved characters.
DATABASE_URL=postgresql+psycopg://garment_app:replace_me@localhost:5432/garment_returns
# Server credentials for Story 000 tests. Tests create and drop only a temporary
# database; they do not migrate or erase the database named here.
TEST_DATABASE_URL=postgresql+psycopg://garment_app:replace_me@localhost:5432/garment_returns

# Loaded by FastAPI and Alembic. This slice issues HTTP-only session cookies.
JWT_SECRET=replace_me
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token

CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Used only when this email does not already exist. A later seed does not reset it.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_me
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin
